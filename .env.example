# ============================================================================
#  valve-watch -- copy to .env for local runs.
#  NEVER commit .env. In CI these come from GitHub Secrets / Variables.
# ============================================================================

# ---------------------------------------------------------------------------
# Telegram (secrets)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prepended to change notifications. A plain @username mention breaks through a
# muted chat, which is the whole design: mute the chat, and only a real change
# will ping you.
TELEGRAM_MENTION=

# Send a quiet status message on runs with nothing to report, so a muted chat
# doubles as a dashboard and silence never means "is it still running?".
# These are always sent with disable_notification, mention-free.
TELEGRAM_HEARTBEAT=true
# 0 = every run (48/day at the default cron). Raise it to keep the history
# readable, e.g. 360 for one status message every 6 hours.
TELEGRAM_HEARTBEAT_MIN_INTERVAL_MINUTES=0

# ---------------------------------------------------------------------------
# Storage. Leave DATABASE_URL unset in CI to keep the SQLite file inside a
# GitHub Actions artifact -- no external service required.
#   postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/watch.db

# ---------------------------------------------------------------------------
# GitHub API. Unauthenticated it allows 60 requests/hour, which this watch list
# outgrows quickly. In Actions the built-in token is passed automatically and
# raises it to 1000/hour; set it here only for local runs.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_COMMIT_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# Steam Web API key -- FREE and instant from https://steamcommunity.com/dev/apikey
# Optional, but it unlocks the single richest CS2 signal:
# ICSGOServers_730/GetGameServersStatus gives the authoritative app version,
# the matchmaking scheduler state, online/searching players, average search
# time and per-datacenter load. Without it that provider stays dormant and
# everything else still works.
# ---------------------------------------------------------------------------
STEAM_WEB_API_KEY=

# ---------------------------------------------------------------------------
# Rate anomalies (commit bursts). Discrete state changes -- a version bump, a
# new preview build -- do not use any of this: a change is an event, not a
# deviation, so it alerts immediately with no warm-up.
# ---------------------------------------------------------------------------
# Sharp moves on constantly-changing counters (player counts, server counts).
# Compared against the PREVIOUS reading, not a daily baseline: player counts
# swing by a factor of two over a day, so a baseline would call every night a
# collapse.
DELTA_ALERT_FRACTION=0.15
DELTA_MIN_ABSOLUTE=500

RATE_MULTIPLIER=2.5
RATE_MIN_ABSOLUTE_DELTA=3
MIN_BASELINE_SAMPLES=7
BASELINE_LOOKBACK_WEEKS=4

# ---------------------------------------------------------------------------
# Run behaviour
# ---------------------------------------------------------------------------
# true -> print messages to stdout instead of sending them (default)
DRY_RUN=true
TIMEZONE=America/Los_Angeles
OBSERVATION_RETENTION_DAYS=120
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# HTTP behaviour
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.5
