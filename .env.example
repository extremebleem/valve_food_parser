# ============================================================================
#  valve-food-monitor -- copy to .env for local runs.
#  NEVER commit .env. In CI these come from GitHub Secrets / Variables.
# ============================================================================

# ---------------------------------------------------------------------------
# Office anchor. Defaults (used when unset) point at Valve's HQ, verified
# 2026-09-16 against OpenStreetMap node 5270634805 and the Bellevue Downtown
# Association directory: 10400 NE 4th St, Bellevue, WA 98004.
# Change these to move the whole system to another office -- no code changes.
# ---------------------------------------------------------------------------
OFFICE_NAME=Valve Corporation HQ
OFFICE_ADDRESS=10400 NE 4th St, Bellevue, WA 98004, USA
OFFICE_LAT=47.6142467
OFFICE_LON=-122.2007170
OFFICE_TIMEZONE=America/Los_Angeles
SEARCH_RADIUS_METERS=2000

# ---------------------------------------------------------------------------
# Storage. Postgres (Supabase / Neon / RDS) in production; sqlite for local dev.
#   postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/monitor.db

# ---------------------------------------------------------------------------
# Telegram (secrets)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_DISABLE_NOTIFICATION=false

# ---------------------------------------------------------------------------
# Load providers (secrets). BestTime is the only source found that exposes a
# live busyness reading for arbitrary venues through a documented API.
# Without it the monitor has nothing to measure -- see docs/RESEARCH.md.
# ---------------------------------------------------------------------------
BESTTIME_API_KEY_PRIVATE=
BESTTIME_API_KEY_PUBLIC=
# Comma-separated, in priority order. "generic_http" expands to everything in
# config/providers.json.
LOAD_PROVIDERS=besttime,generic_http
# A forecast is not a measurement; keep this false unless you know why you want it.
BESTTIME_ALLOW_FORECAST_AS_LOAD=false
# Bounds the one-off onboarding cost (2 credits per venue, once ever).
BESTTIME_MAX_NEW_FORECASTS_PER_RUN=10
GENERIC_PROVIDER_CONFIG=config/providers.json

# ---------------------------------------------------------------------------
# Discovery. OSM/Overpass needs no key and is enabled by default.
# Google and Foursquare turn themselves on when their key is present.
# ---------------------------------------------------------------------------
ENABLE_OSM_DISCOVERY=true
GOOGLE_MAPS_API_KEY=
FOURSQUARE_API_KEY=
# ENABLE_GOOGLE_DISCOVERY=false
# ENABLE_FOURSQUARE_DISCOVERY=false
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# DEDUPE_DISTANCE_METERS=75
# DEDUPE_NAME_RATIO=0.82
VENUE_STALE_DAYS=21

# ---------------------------------------------------------------------------
# Baseline and anomaly detection
# ---------------------------------------------------------------------------
ANOMALY_MULTIPLIER=1.5
MIN_BASELINE_SAMPLES=5
BASELINE_LOOKBACK_WEEKS=8
BASELINE_WINDOW_MINUTES=60
# Guards that stop mathematically-true-but-useless alerts
ANOMALY_MIN_SCORE=55
ANOMALY_MIN_ABSOLUTE_DELTA=10
ANOMALY_MIN_ROBUST_Z=3.0
ANOMALY_REQUIRE_ROBUST_Z=true
ANOMALY_MIN_CONFIDENCE=0.4
# Off by default: never alert without a baseline to justify it.
ANOMALY_FALLBACK_ABSOLUTE_ENABLED=false
ANOMALY_FALLBACK_ABSOLUTE_SCORE=90

# ---------------------------------------------------------------------------
# Alerting / anti-spam
# ---------------------------------------------------------------------------
ALERT_COOLDOWN_MINUTES=120
ALERT_REARM_MINUTES=30
ALERT_ESCALATION_DELTA=15
SEND_RECOVERY_ALERTS=true
RECOVERY_RATIO=1.15
MAX_ALERTS_PER_RUN=12
AGGREGATE_ALERTS=true

# ---------------------------------------------------------------------------
# Active window -- hours of the day, in the OFFICE'S LOCAL TIME, when the
# monitor does anything at all. Outside it the run exits immediately without
# touching a single API. Evaluated against OFFICE_TIMEZONE, so DST never shifts
# it. Set START == END to disable the gate (24/7).
#
# NOTE: 14-21 skips the lunch peak (~11:30-13:30). Use ACTIVE_HOURS_START=11 to
# cover lunch as well.
# ---------------------------------------------------------------------------
ACTIVE_HOURS_START=14
ACTIVE_HOURS_END=21
# 0=Mon .. 6=Sun
ACTIVE_WEEKDAYS=0,1,2,3,4,5,6

# ---------------------------------------------------------------------------
# Run behaviour
# ---------------------------------------------------------------------------
# true  -> print messages to stdout instead of sending them (default)
DRY_RUN=true
SKIP_CLOSED_VENUES=true
ASSUME_OPEN_WHEN_UNKNOWN=true
# Keep the provider's raw JSON with each observation (good for debugging and for
# re-normalising history). Costs ~46% of the row size -- set false if the
# database is tight. Measured: 412 bytes/row with it, 222 bytes/row without.
STORE_RAW_VALUE=true
MAX_VENUES_PER_RUN=150
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# HTTP behaviour
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.5
HTTP_CACHE_TTL_SECONDS=300
BESTTIME_RATE_LIMIT_RPS=4

# ---------------------------------------------------------------------------
# Normalisation envelopes: raw metric -> load_score 0..100 (LOW maps to 0)
# ---------------------------------------------------------------------------
NORM_DELIVERY_ETA_LOW_MIN=15
NORM_DELIVERY_ETA_HIGH_MIN=75
NORM_PICKUP_ETA_LOW_MIN=5
NORM_PICKUP_ETA_HIGH_MIN=45
NORM_WAIT_LOW_MIN=0
NORM_WAIT_HIGH_MIN=60
NORM_RESERVATION_LOW_MIN=0
NORM_RESERVATION_HIGH_MIN=180
NORM_QUEUE_LOW=0
NORM_QUEUE_HIGH=25
NORM_PREP_LOW_MIN=5
NORM_PREP_HIGH_MIN=45
