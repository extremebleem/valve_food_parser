{
  "_comment": [
    "Optional declarative load providers. Copy to config/providers.json (gitignored).",
    "Only use endpoints you are contractually allowed to call.",
    "Secrets are referenced as ${ENV_VAR} and resolved at request time.",
    "Placeholders available in url_template/headers/query/json_body:",
    "  {venue_id} {name} {address} {latitude} {longitude} {category} {source_id}",
    "Valid metric_type values: live_busyness_index, forecast_busyness_index,",
    "  live_vs_forecast_delta, delivery_eta_minutes, pickup_eta_minutes,",
    "  prep_time_minutes, wait_time_minutes, queue_length,",
    "  next_reservation_minutes, load_score_direct"
  ],
  "providers": [
    {
      "name": "pos_pickup_eta",
      "enabled": false,
      "metric_type": "pickup_eta_minutes",
      "domain": "pickup_congestion",
      "signal_quality": "high",
      "confidence": 0.9,
      "method": "GET",
      "url_template": "https://pos.example.com/v1/stores/{source_id}/quote",
      "source_id_key": "pos",
      "require_source_id": true,
      "headers": { "Authorization": "Bearer ${POS_API_TOKEN}" },
      "value_path": "quote.pickup_eta_minutes",
      "rate_limit_rps": 2
    },
    {
      "name": "delivery_partner_eta",
      "enabled": false,
      "metric_type": "delivery_eta_minutes",
      "domain": "delivery_congestion",
      "signal_quality": "medium",
      "confidence": 0.6,
      "method": "POST",
      "url_template": "https://partner.example.com/v2/quotes",
      "headers": {
        "Authorization": "Bearer ${DELIVERY_PARTNER_TOKEN}",
        "Content-Type": "application/json"
      },
      "json_body": {
        "pickup_address": "{address}",
        "pickup_latitude": "{latitude}",
        "pickup_longitude": "{longitude}"
      },
      "value_path": "data.estimated_delivery_minutes",
      "require_delivery": true,
      "rate_limit_rps": 1
    },
    {
      "name": "self_hosted_queue_counter",
      "enabled": false,
      "metric_type": "queue_length",
      "domain": "physical_occupancy",
      "signal_quality": "high",
      "confidence": 0.95,
      "method": "GET",
      "url_template": "https://queue.example.com/venues/{venue_id}/current",
      "value_path": "people_waiting",
      "cache_ttl_seconds": 60
    }
  ]
}
